{
  "version": 8,
  "name": "Australia Is Beautiful",
  "glyphs": "/map/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "aib": {
      "type": "vector",
      "url": "pmtiles:///map/australia.pmtiles",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#e8eddc" }
    },

    {
      "id": "landcover-farmland",
      "type": "fill",
      "source": "aib",
      "source-layer": "landcover",
      "filter": ["in", "class", "farmland", "grass"],
      "paint": { "fill-color": "#dde5cb" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "aib",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": {
        "fill-color": "#b3ce9c",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4,
          0.55,
          9,
          0.85
        ]
      }
    },

    {
      "id": "park",
      "type": "fill",
      "source": "aib",
      "source-layer": "park",
      "minzoom": 9,
      "paint": {
        "fill-color": "#a3c98a",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          9,
          0,
          11,
          0.9
        ]
      }
    },
    {
      "id": "park-edge",
      "type": "line",
      "source": "aib",
      "source-layer": "park",
      "minzoom": 12,
      "paint": {
        "line-color": "#8ab470",
        "line-width": 1,
        "line-opacity": 0.6
      }
    },

    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "aib",
      "source-layer": "landuse",
      "filter": ["in", "class", "residential", "suburb", "neighbourhood"],
      "paint": { "fill-color": "#f1f1e8" }
    },

    {
      "id": "water",
      "type": "fill",
      "source": "aib",
      "source-layer": "water",
      "filter": ["!=", "brunnel", "tunnel"],
      "paint": { "fill-color": "#a5c9d8" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "aib",
      "source-layer": "waterway",
      "minzoom": 8,
      "paint": {
        "line-color": "#a5c9d8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 14, 3]
      }
    },

    {
      "id": "building",
      "type": "fill",
      "source": "aib",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#e2ddd0",
        "fill-outline-color": "#cfc9b9"
      }
    },

    {
      "id": "roads-minor-casing",
      "type": "line",
      "source": "aib",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "minzoom": 13,
      "paint": {
        "line-color": "#d8d6c8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 2, 16, 7, 19, 18]
      }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "aib",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "minzoom": 13,
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 1, 16, 5, 19, 15]
      }
    },

    {
      "id": "roads-secondary-casing",
      "type": "line",
      "source": "aib",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "minzoom": 10,
      "paint": {
        "line-color": "#cfccbc",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 2.5, 14, 7, 18, 20]
      }
    },
    {
      "id": "roads-secondary",
      "type": "line",
      "source": "aib",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "minzoom": 10,
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1.4, 14, 5, 18, 16]
      }
    },

    {
      "id": "roads-primary-casing",
      "type": "line",
      "source": "aib",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "paint": {
        "line-color": "#c4bda6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 2, 10, 5, 14, 11, 18, 26]
      }
    },
    {
      "id": "roads-primary",
      "type": "line",
      "source": "aib",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "paint": {
        "line-color": "#fdfbf2",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1, 10, 3.2, 14, 8, 18, 21]
      }
    },

    {
      "id": "boundary-state",
      "type": "line",
      "source": "aib",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 4],
      "paint": {
        "line-color": "#a8a48f",
        "line-width": 1.1,
        "line-dasharray": [4, 3]
      }
    },

    {
      "id": "place-suburb",
      "type": "symbol",
      "source": "aib",
      "source-layer": "place",
      "filter": ["in", "class", "suburb", "neighbourhood", "village", "hamlet"],
      "minzoom": 11,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11.5,
        "text-letter-spacing": 0.05,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#6e7566",
        "text-halo-color": "#f7f8f0",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "aib",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 12, 10, 16],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#3a4235",
        "text-halo-color": "#f7f8f0",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-state",
      "type": "symbol",
      "source": "aib",
      "source-layer": "place",
      "filter": ["==", "class", "state"],
      "maxzoom": 7,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Medium"],
        "text-size": 12,
        "text-letter-spacing": 0.24,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#8a8f7d",
        "text-halo-color": "#e8eddc",
        "text-halo-width": 1.6
      }
    }
  ]
}
